{
    "__comment_INPUT": "The full path of the input directory for proteomes",
    "__comment_DNA_INPUT": "The full path of the input directory for genome data",
    "__comment_CORE_RESULTS": "The dynamically resolved directory containing the named core run results",
    "__comment_SPECIES_TREE": "Path to the species tree file",
    "__comment_USER_CONFIG": "Path to the user configuration file",
    "__comment_EXAMPLE_DATA": "Absolute path to the repository ExampleData directory",
    "Direct": {
        "user_config": "orthofinder -f INPUT --config USER_CONFIG -pof",
        "methodthreads_minseq": "orthofinder -f INPUT -mt 2 -ms 5 -pof",
        "v2_scores_output_extension": "orthofinder -f INPUT --scores-v2 -efn -pof",
        "blast": "orthofinder -f INPUT -S blast -pof --no-print-info",
        "mmseqs": "orthofinder -f INPUT -S mmseqs -pof --no-print-info",
        "dendroblast": "orthofinder -f INPUT -M dendroblast -pof --no-print-info",
        "mafft": "orthofinder -f INPUT -A mafft -pof --no-print-info",
        "iqtree3": "orthofinder -f INPUT -T iqtree3 -pof --no-print-info",
        "fasttree_fastest": "orthofinder -f INPUT -T fasttree_fastest -pof --no-print-info",
        "raxml": "orthofinder -f INPUT -T raxml -pof --no-print-info",
        "astral": "orthofinder -f INPUT -ST astral -nk 2 -pof --no-print-info",
        "oneway_search": "orthofinder -f INPUT -1 -z -y -pof --no-print-info",
        "no_fix_files": "orthofinder -f INPUT --no-fix-files -pof --no-print-info",
        "old_version": "orthofinder -f INPUT --old-version -pof --no-print-info",
        "dna": "orthofinder -f DNA_INPUT -d -pof --no-print-info"
    },
    "Core": {
        "famsa": "orthofinder -f INPUT -pof --no-print-info",
        "famsa_species_tree": "orthofinder -f INPUT -s SPECIES_TREE -rmgt -rmrgt -rmlg -pof --no-print-info",
        "diamond_first": "orthofinder -f EXAMPLE_DATA -pof --no-print-info",
        "mmseqs_first": "orthofinder -f EXAMPLE_DATA -pof --no-print-info -S mmseqs"
    },
    "StopAfter": {
        "stop_after_orthogroups": "orthofinder -f INPUT -og -pof",
        "stop_after_genetrees": "orthofinder -f INPUT -ogt -pof",
        "stop_after_speciestrees": "orthofinder -f INPUT -ost -pof",
        "stop_after_prepare_blast": "orthofinder -f EXAMPLE_DATA -op -pof --no-print-info"
    },

    "Restart": {
        "stop_after_genetrees_restart": "orthofinder -fgt CORE_RESULTS -pof",
        "stop_after_speciestrees_restart": "orthofinder -fst CORE_RESULTS -pof",
        "stop_after_orthogroups_restart": "orthofinder -fg CORE_RESULTS -pof",
        "stop_after_prepare_blast_restart": "orthofinder -b CORE_RESULTS -pof --no-print-info"
    },
    "Assign": {
        "famsa_assign": "orthofinder --core CORE_RESULTS --assign INPUT -nk 2 -pof --no-print-info",
        "famsa_species_tree_assign": "orthofinder --core CORE_RESULTS --assign INPUT -s SPECIES_TREE -rmgt -rmrgt -rmlg -pof --no-print-info",
        "stop_after_prepare_blast_restart_assign": "orthofinder --core CORE_RESULTS --assign EXAMPLE_DATA/AdditionalSpecies -pof --no-print-info",
        "diamond_first_assign": "orthofinder --core CORE_RESULTS --assign EXAMPLE_DATA/AdditionalSpecies -pof --no-print-info -S mmseqs",
        "mmseqs_first_assign": "orthofinder --core CORE_RESULTS --assign EXAMPLE_DATA/AdditionalSpecies -pof --no-print-info"
    }
}
